# 주차마스터 백엔드 환경 변수 예시
# 실제 운영 시 .env 파일로 복사 후 값 채울 것 (.env는 절대 Git에 커밋 금지)

# === 서버 ===
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# === PostgreSQL ===
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=parkmaster
PG_USER=parkmaster_app
PG_PASSWORD=change_me

# === JWT (운영 시 64자 이상의 무작위 문자열로 변경) ===
JWT_SECRET=change_me_to_a_random_secret_at_least_64_chars_long_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# === 쿠키 ===
COOKIE_SECURE=false
COOKIE_DOMAIN=

# === CORS (프론트엔드 주소) ===
CORS_ORIGIN=http://localhost:5173

# === 파일 업로드 ===
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=20

# === 초기 관리자 계정 (seed:admin 실행 시 사용) ===
ADMIN_EMAIL=admin@parkmaster.local
ADMIN_PASSWORD=change_me_before_first_run
ADMIN_NAME=시스템관리자

# === 기존 Supabase 데이터 이전 전용 (선택) ===
# import:supabase 및 verify:import 실행 시에만 입력합니다.
# service_role 키는 절대 Git에 커밋하지 말고 이전 후 폐기 또는 제거합니다.
SOURCE_SUPABASE_URL=
SOURCE_SUPABASE_SERVICE_KEY=

# === 내부 LLM (선택) ===
# 부서 서버에 Ollama 등 LLM 서버 설치 시 활성화
# 비어있으면 AI 어시스턴트는 503 응답하며 호출자는 안전하게 처리합니다.
AI_BASE_URL=
AI_MODEL=qwen2.5:7b
AI_PROVIDER=ollama
