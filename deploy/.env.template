# Values appended to the official self-hosted Supabase .env by setup.sh.
PARKMASTER_HOSTNAME=parkmaster.internal.example
PARKMASTER_BIND_ADDRESS=0.0.0.0
PARKMASTER_INTERNAL_CIDR=10.0.0.0/8
PARKMASTER_MANAGEMENT_CIDR=10.0.0.0/8

# Naver Maps is the only required runtime internet integration.
NAVER_MAP_CLIENT_ID=
NAVER_MAP_CLIENT_SECRET=

# External AI is denied by default. Enable only after an agency security review.
AI_ENABLED=false
# Full OpenAI-compatible chat completions endpoint, not only the host name.
AI_GATEWAY_URL=
AI_API_KEY=
AI_MODEL=
AI_ALLOWED_HOSTS=

# Optional external sensor console, blank means hidden.
SENSOR_CONSOLE_URL=

# Backups are encrypted with a key file owned by root (mode 600).
BACKUP_ENCRYPTION_KEY_FILE=/etc/parkmaster/backup.key
BACKUP_RETENTION_DAYS=90
